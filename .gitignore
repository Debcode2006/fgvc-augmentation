# Generated experiment artefacts are tracked (splits, logs, dataframes, plots)
# so results are visible on GitHub without re-running the pipeline. Model
# checkpoints are excluded: large binaries, and trivially regenerable via
# `python -m cicps train` (see README.md).
outputs/**/checkpoints/

# Smoke-test runs: plumbing checks only, numbers are meaningless
# (docs/experiment_0a.md §26, docs/experiment_0b.md §25).
outputs/smoke_0a/
outputs/smoke_0b/
outputs/smoke_1a/

# The dataset is not tracked; see docs/experiment_0a.md for the expected layout.
data/

# Environments and build artefacts
.venv/
*.egg-info/
build/
dist/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
